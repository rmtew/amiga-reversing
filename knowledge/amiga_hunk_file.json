        {
          "name": "size_word",
          "primitive": "u32"
        },
        {
          "name": "data",
          "type": "byte_blob",
          "length_expr": "size_longs_word.size_longs * 4"
        }
      ]
    },
    "HUNK_BSS": {
      "id_name": "HUNK_BSS",
