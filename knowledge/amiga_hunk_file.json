      "role": "section_start",
      "section_kind": "code",
      "fields": [
        {
          "name": "mem_attrs",
          "primitive": "u32",
          "present_if": "hunk_type_word.chip == 1 and hunk_type_word.fast == 1"
        },
        {
          "name": "size_word",
          "primitive": "u32"
        },
        {
          "name": "data",
          "type": "byte_blob",
          "length_expr": "size_longs_word.size_longs * 4"
        }
      ]
    },
    "HUNK_DATA": {
      "id_name": "HUNK_DATA",
      "role": "section_start",
      "section_kind": "data",
      "fields": [
