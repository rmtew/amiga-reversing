              "name": "size_word",
              "primitive": "u32"
            },
            {
              "name": "mem_attrs",
              "primitive": "u32",
              "present_if": "size_word >> 30 == 3"
            }
          ],
          "count_expr": "last_hunk - first_hunk + 1"
        }
      ]
    },
    "HUNK_UNIT": {
