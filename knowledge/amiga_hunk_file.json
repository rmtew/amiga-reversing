          "EXT_RES": "definition",
          "EXT_REF32": "reference",
          "EXT_REF16": "reference",
          "EXT_REF8": "reference",
          "EXT_DEXT32": "reference",
          "EXT_DEXT16": "reference",
          "EXT_DEXT8": "reference",
          "EXT_RELREF32": "reference",
          "EXT_ABSREF16": "reference",
          "EXT_ABSREF8": "reference",
