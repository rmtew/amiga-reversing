{
  "_meta": {
    "name": "atari_st_disk_file",
    "description": "Normalized Atari ST raw disk image and GEMDOS FAT12 filesystem metadata for helper/runtime generation.",
    "endianness": "little",
    "sources": [
      {
        "type": "repo_local_document",
        "path": "resources/platform_atari_st/GEMDOS.TXT",
        "section": "~/text/gemdos/diskstruct",
        "date": "1986-04-04",
        "note": "Primary repo-local reference for GEMDOS BPB, directory entries, and FAT12 cluster semantics."
      },
      {
        "type": "repo_local_document",
        "path": "resources/platform_atari_st/GEM_0042.pdf",
        "note": "Supplementary repo-local GEMDOS reference retained alongside GEMDOS.TXT."
      },
      {
        "type": "external_document",
        "url": "https://info-coach.fr/atari/documents/_mydoc/Pasti-documentation.pdf",
        "section": "2.1–2.2.5",
        "note": "Jean Louis-Guérin, Pasti File Documentation v0.5 (2014); reverse-engineered format description, checked against pinned Hatari reader. No implementation copied."
      }
    ]
  },
  "primitives": {
    "u8": {
      "kind": "integer",
      "bytes": 1,
      "signed": false,
      "endianness": "little"
    },
    "u16": {
      "kind": "integer",
      "bytes": 2,
      "signed": false,
      "endianness": "little"
    },
    "u32": {
      "kind": "integer",
      "bytes": 4,
      "signed": false,
      "endianness": "little"
    },
    "raw_bytes_by_length": {
      "kind": "byte_blob",
      "length_type": "external"
    }
  },
  "enums": {
    "record_tag": {
      "BOOT_SECTOR": 1,
      "FAT": 2,
      "ROOT_DIRECTORY": 3,
      "DATA_REGION": 4,
      "DIRECTORY_ENTRY": 5
    },
    "dir_attr": {
      "READ_ONLY": 1,
      "HIDDEN": 2,
      "SYSTEM": 4,
      "VOLUME_LABEL": 8,
      "DIRECTORY": 16,
      "ARCHIVE": 32
    },
    "fat_type": {
      "FAT12": 12
    },
    "stx_track_flags": {"SECTOR_DESCRIPTORS": 1, "LEGACY_MARKER": 32, "IMAGE": 64, "IMAGE_SYNC": 128},
    "stx_sector_flags": {"VARIABLE_TIME": 1, "CRC_ERROR": 8, "NO_DATA": 16, "DELETED": 32, "FUZZY": 128},
    "stx_limits": {"VERSION": 3, "HEADER_BYTES": 16, "TRACK_HEADER_BYTES": 16, "SECTOR_HEADER_BYTES": 16, "SIMPLE_SECTOR_BYTES": 512, "SIZE_CODE_MASK": 3, "TIMING_HEADER_BYTES": 4, "TIMING_CHUNK_BYTES": 16, "TIMING_ENTRY_BYTES": 2}
  },
  "bitfields": {
    "dir_attr_word": {
      "fields": {
        "read_only": { "bit": 0 },
        "hidden": { "bit": 1 },
        "system": { "bit": 2 },
        "volume_label": { "bit": 3 },
        "directory": { "bit": 4 },
        "archive": { "bit": 5 }
      }
    }
  },
  "record_types": {
    "BOOT_SECTOR": {
      "id_name": "BOOT_SECTOR",
      "role": "container_header",
      "source": {
        "path": "resources/platform_atari_st/GEMDOS.TXT",
        "section": "~/text/gemdos/diskstruct",
        "topic": "BIOS Parameter Block (BPB)"
      },
      "fields": [
        { "name": "jump", "type": "byte_blob", "length_expr": "3" },
        { "name": "oem", "type": "byte_blob", "length_expr": "8" },
        { "name": "bytes_per_sector", "primitive": "u16", "source": { "path": "resources/platform_atari_st/GEMDOS.TXT", "section": "~/text/gemdos/diskstruct", "topic": "RECSIZ indicates the number of bytes per physical sector" } },
        { "name": "sectors_per_cluster", "primitive": "u8", "source": { "path": "resources/platform_atari_st/GEMDOS.TXT", "section": "~/text/gemdos/diskstruct", "topic": "CLSIZ indicates the number of sectors in a cluster" } },
        { "name": "reserved_sector_count", "primitive": "u16" },
        { "name": "fat_count", "primitive": "u8" },
        { "name": "root_entry_count", "primitive": "u16", "source": { "path": "resources/platform_atari_st/GEMDOS.TXT", "section": "~/text/gemdos/diskstruct", "topic": "RDLEN is the size of the root directory" } },
        { "name": "total_sectors", "primitive": "u16" },
        { "name": "media_descriptor", "primitive": "u8" },
        { "name": "sectors_per_fat", "primitive": "u16", "source": { "path": "resources/platform_atari_st/GEMDOS.TXT", "section": "~/text/gemdos/diskstruct", "topic": "FSIZ is the size of each FAT in sectors" } },
        { "name": "sectors_per_track", "primitive": "u16" },
        { "name": "side_count", "primitive": "u16" },
        { "name": "hidden_sector_count", "primitive": "u16" }
      ]
    },
    "FAT": {
      "id_name": "FAT",
      "role": "container_aux",
      "fields": [
        { "name": "entries", "type": "fat12_entries" }
      ]
    },
    "ROOT_DIRECTORY": {
      "id_name": "ROOT_DIRECTORY",
      "role": "container_aux",
      "fields": [
        { "name": "entries", "type": "directory_entry_array" }
      ]
    },
    "DATA_REGION": {
      "id_name": "DATA_REGION",
      "role": "container_aux",
      "fields": [
        { "name": "clusters", "type": "cluster_array" }
      ]
    },
    "DIRECTORY_ENTRY": {
      "id_name": "DIRECTORY_ENTRY",
      "role": "container_aux",
      "source": {
        "path": "resources/platform_atari_st/GEMDOS.TXT",
        "section": "~/text/gemdos/diskstruct",
        "topic": "Directory Entry"
      },
      "fields": [
        { "name": "name_raw", "type": "byte_blob", "length_expr": "8" },
        { "name": "ext_raw", "type": "byte_blob", "length_expr": "3" },
        { "name": "attributes", "primitive": "u8" },
        { "name": "reserved", "type": "byte_blob", "length_expr": "10" },
        { "name": "time_word", "primitive": "u16" },
        { "name": "date_word", "primitive": "u16" },
        { "name": "first_cluster", "primitive": "u16", "source": { "path": "resources/platform_atari_st/GEMDOS.TXT", "section": "~/text/gemdos/diskstruct", "topic": "WORD starting cluster#" } },
        { "name": "file_size", "primitive": "u32", "source": { "path": "resources/platform_atari_st/GEMDOS.TXT", "section": "~/text/gemdos/diskstruct", "topic": "LONG file length" } }
      ]
    },
    "STX_HEADER": {
      "role": "container_aux",
      "source": {"url": "https://info-coach.fr/atari/documents/_mydoc/Pasti-documentation.pdf", "section": "2.1–2.2.5"},
      "fields": [
        {"name": "signature", "type": "byte_blob", "length_expr": "4"},
        {"name": "version", "primitive": "u16"},
        {"name": "tool", "primitive": "u16"},
        {"name": "reserved1", "primitive": "u16"},
        {"name": "track_count", "primitive": "u8"},
        {"name": "revision", "primitive": "u8"},
        {"name": "reserved2", "primitive": "u32"}
      ]
    },
    "STX_TRACK": {
      "role": "container_aux",
      "source": {"url": "https://info-coach.fr/atari/documents/_mydoc/Pasti-documentation.pdf", "section": "2.1–2.2.5"},
      "fields": [
        {"name": "record_size", "primitive": "u32"},
        {"name": "fuzzy_size", "primitive": "u32"},
        {"name": "sector_count", "primitive": "u16"},
        {"name": "flags", "primitive": "u16"},
        {"name": "mfm_size", "primitive": "u16"},
        {"name": "number", "primitive": "u8"},
        {"name": "record_type", "primitive": "u8"}
      ]
    },
    "STX_SECTOR": {
      "role": "container_aux",
      "source": {"url": "https://info-coach.fr/atari/documents/_mydoc/Pasti-documentation.pdf", "section": "2.1–2.2.5"},
      "fields": [
        {"name": "data_offset", "primitive": "u32"},
        {"name": "bit_position", "primitive": "u16"},
        {"name": "read_time", "primitive": "u16"},
        {"name": "id_track", "primitive": "u8"},
        {"name": "id_head", "primitive": "u8"},
        {"name": "id_sector", "primitive": "u8"},
        {"name": "id_size", "primitive": "u8"},
        {"name": "id_crc_be", "type": "byte_blob", "length_expr": "2"},
        {"name": "status", "primitive": "u8"},
        {"name": "reserved", "primitive": "u8"}
      ]
    },
    "STX_TIMING": {
      "role": "container_aux",
      "source": {"url": "https://info-coach.fr/atari/documents/_mydoc/Pasti-documentation.pdf", "section": "2.1–2.2.5"},
      "fields": [
        {"name": "flags", "primitive": "u16"},
        {"name": "size", "primitive": "u16"}
      ]
    }
  },
  "groups": {
    "filesystem_regions": {
      "sequence": [
        "FAT",
        "ROOT_DIRECTORY",
        "DATA_REGION"
      ]
    }
  },
  "containers": {
    "st_disk_image": {
      "magic_record": "BOOT_SECTOR",
      "top_level_sequence": [
        "BOOT_SECTOR",
        "filesystem_regions"
      ]
    }
  },
  "interpretation_rules": [],
  "relocation_kinds": {},
  "debug_kinds": {},
  "constraints": {
    "raw_container_extensions": [
      ".st"
    ],
    "supported_fat_types": [
      "FAT12"
    ],
    "root_directory_entry_bytes": 32,
    "cluster_number_starts_at": 2,
    "volume_label_entries_live_in_root_directory": true
  },
  "notes": [
    {
      "topic": "scope",
      "text": "This file models raw .st sector images and GEMDOS-style FAT12 structures, not PRG payload semantics."
    },
    {
      "topic": "fat12",
      "text": "Current implementation scope is FAT12 as documented in GEMDOS.TXT; the BPB note about 16-bit FAT entries is retained as a future extension point."
    }
  ]
}
