;;; D_SFSQ
;;;	movem.l	D1-D7/A0-A6,-(SP)
;;;	cmp.w	#'SQ',(A0)
;;;	beq.w	D_SQ

; SF decruncher:
; Input: A0 -> Crunched Data (source)
;        A1 -> Decrunch Buffer (destination)
; Used registers: A0,A1,A2,A4 + A6, D0,D1,D2,D3,D4,D5,D6,D7

D_SF
;;;	MOVEM.L	D1-D7/A0-A6,-(SP)
;	MOVEA.L	A1,A4				; -> Decrunch Buffer
;	MOVEA.L	A0,A2				; -> Crunched Data (header)
;	LEA	10(A2),A1			; -> Crunched Data (past header)
;	MOVEA.L	A4,A5				; -> Decrunch Buffer
;	MOVE.L	2(A0),D0			; Decrunched Size
;;;	MOVEA.L	D0,A6
;	ADDA.L	D0,A4				; -> End of Decrunch Buffer
;	MOVE.L	6(A0),D2			; Crunched Size
;	ADDA.L	D2,A0				; -> End of Crunched Data
;	MOVE.L	D2,D7				; Crunched Size
;	ADDQ.L	#3,D7
;	LSR.L	#2,D7
;	SUBQ.L	#1,D7
; lbC000612	MOVE.L	(A1)+,(A2)+		; Move crunched data
;	DBRA	D7,lbC000612

	ADDQ.L	#2,A0				; Skip ID
	MOVEA.L	A1,A4				; -> Decrunch Buffer
	ADD.L	(A0)+,A4			; -> End of Decrunch Buffer
	MOVE.L	(A0)+,D0			; Crunched Size
	MOVE.L	A0,A6				; -> Begin of Crunched Data
	ADD.L	D0,A0				; -> End of Cruched Data

; A0 -> End of Crunched Data
; A1 -> Begin of Decrunch Buffer
; A4 -> End of Decrunch Buffer
; A6 -> Begin of Crunched Data

	MOVE.B	-(A0),D0			; Compressed Data
lbC00061A	ADD.B	D0,D0
	BNE.S	lbC000626
	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC000626	BCC.W	lbC0006CC
	ADD.B	D0,D0
	BNE.S	lbC000636
	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC000636	BCC.S	lbC000698
	ADD.B	D0,D0
	BNE.S	lbC000644
	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC000644	BCC.S	lbC00069E
	ADD.B	D0,D0
	BNE.S	lbC000652
	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC000652	BCC.S	lbC0006A4
	ADD.B	D0,D0
	BNE.S	lbC000660
	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC000660	BCC.S	lbC000666
	MOVEQ	#9,D4
	BRA.S	lbC000668

lbC000666	MOVEQ	#14,D4
lbC000668	MOVEQ	#1,D2
	MOVEQ	#1,D3
	MOVEQ	#5,D5
lbC00066E	MOVE.W	D2,D1
	SUBQ.W	#1,D1
	MOVEQ	#0,D7
lbC000674	ADD.B	D0,D0
	BNE.S	lbC000680

	CMP.L	A6,A0				; Check read pointer
	BLS	SF_Error

	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC000680	ADDX.W	D7,D7
	DBRA	D1,lbC000674
	ADD.W	D7,D5
	CMP.W	D3,D7
	BNE.S	lbC000694
	ADDQ.W	#1,D2
	ADD.W	D3,D3
	ADDQ.W	#1,D3
	BRA.S	lbC00066E

lbC000694	MOVE.W	D4,D1
	BRA.S	lbC0006A8

lbC000698	MOVEQ	#9,D1
	MOVEQ	#2,D5
	BRA.S	lbC0006A8

lbC00069E	MOVEQ	#10,D1
	MOVEQ	#3,D5
	BRA.S	lbC0006A8

lbC0006A4	MOVEQ	#12,D1
	MOVEQ	#4,D5
lbC0006A8	SUBQ.W	#1,D1
	MOVEQ	#0,D7
lbC0006AC	ADD.B	D0,D0
	BNE.S	lbC0006B8

	CMP.L	A6,A0				; Check read pointer
	BLS	SF_Error

	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC0006B8	ADDX.W	D7,D7
	DBRA	D1,lbC0006AC
	LEA	0(A4,D7.W),A2
	SUBQ.W	#1,D5
lbC0006C4	
	CMP.L	A1,A4				; Check write pointer
	BLS	SF_Error

	MOVE.B	-(A2),-(A4)
	DBRA	D5,lbC0006C4
	BRA.S	lbC000700

lbC0006CC	MOVEQ	#1,D2
	MOVEQ	#1,D3
	MOVEQ	#1,D6
lbC0006D2	MOVE.W	D2,D1
	SUBQ.W	#1,D1
	MOVEQ	#0,D7
lbC0006D8	ADD.B	D0,D0
	BNE.S	lbC0006E4

	CMP.L	A6,A0				; Check read pointer
	BLS	SF_Error

	MOVE.B	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.B	D0,D0
lbC0006E4	ADDX.W	D7,D7
	DBRA	D1,lbC0006D8
	ADD.W	D7,D6
	CMP.W	D3,D7
	BNE.S	lbC0006F8
	ADDQ.W	#1,D2
	ADD.W	D3,D3
	ADDQ.W	#1,D3
	BRA.S	lbC0006D2

lbC0006F8	SUBQ.W	#1,D6
lbC0006FA
	CMP.L	A1,A4				; Check write pointer
	BLS	SF_Error

	MOVE.B	-(A0),-(A4)
	DBRA	D6,lbC0006FA
lbC000700	CMPA.L	A1,A4
	BNE.W	lbC00061A
;;;	MOVE.L	A6,D0
;;;	MOVEM.L	(SP)+,D1-D7/A0-A6
	MOVEQ	#1,D0				; Success
	RTS

SF_Error
	MOVEQ	#0,D0				; Error
	RTS

; SQ decruncher:
; Input: A0 -> Crunched Data (source)
;        A1 -> Decrunch Buffer (destination)
; Used registers: A0,A1,A2 + A3, D0,D1,D4,D5,D6,D7 + D3 + D2

lbC00072E	SUBQ.W	#1,D1
	MOVEQ	#0,D7
.lbC000732	ADD.L	D0,D0
	BNE.S	.lbC00073E
	MOVE.L	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.L	D0,D0
.lbC00073E	ADDX.W	D7,D7
	DBRA	D1,.lbC000732
	RTS

D_SQ	MOVEA.L	A1,A2
	ADDQ.L	#2,A0				; Skip ID
	MOVE.L	(A0)+,D0			; Decrunched Size
	MOVE.L	D0,D3
	ADDQ.L	#7,D0				; Round up to the next multiple of 8
	ANDI.B	#$F8,D0
	ADDA.L	D0,A1				; End of Decrunch buffer
	MOVE.B	(A0),D2				; Compression Mode
	MOVE.L	(A0)+,D0			; Crunched Size/4
;;	MOVE.L	D0,D1
	ANDI.L	#$FFFFFF,D0
	LSL.L	#2,D0				; Crunched Size
	MOVE.L	A0,A3				; Begin of crunched Data
	ADDA.L	D0,A0				; End of crunched Data
	MOVE.L	-(A0),D0			; Compressed Data
;;	LSR.L	#8,D1
;;	SWAP	D1
;;	MOVE.W	D1,D2				; Compression Mode
	MOVEQ	#3,D1
	BSR.S	lbC00072E
	MOVE.W	D7,D6
	ADDQ.W	#1,D6
lbC000776	MOVE.W	#8-1,D5
lbC00077A	MOVE.W	D6,D1

	CMP.L	A3,A0				; Check read pointer
	BLO	SQ_Error

	BSR.S	lbC00072E

	CMP.L	A2,A1				; Check write pointer
	BLS	SQ_Error

	MOVE.B	D7,-(A1)			; Write Data
	DBRA	D5,lbC00077A
	MOVEQ	#0,D4
lbC000786	ADD.L	D0,D0
	BNE.S	lbC000792

	CMP.L	A3,A0				; Check read pointer
	BLS	SQ_Error

	MOVE.L	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.L	D0,D0
lbC000792	BCC.S	lbC000798
	ADDQ.W	#1,D4
	BRA.S	lbC000786

lbC000798	ADDQ.W	#1,D4
	LSR.W	#1,D4
	BCS.S	lbC0007A0
	NEG.W	D4
lbC0007A0	SUB.W	D4,D6
	CMPA.L	A2,A1
	BNE.S	lbC000776

	MOVE.L	D3,D0				; Decrunched Size
	CMP.B	#1,D2				; Compression Mode = 1
	BEQ.S	lbC0007F8
	CMP.B	#2,D2				; Compression Mode = 2
	BEQ.S	lbC0007BC
	CMP.B	#3,D2				; Compression Mode = 3
	BEQ.S	lbC0007D8
lbC0007BC	MOVEQ	#0,D4
lbC0007BE	MOVE.B	(A2),D1
	LSR.B	#1,D1
	BCC.S	lbC0007C8
	NEG.B	D1
	SUBQ.B	#1,D1
lbC0007C8	ADD.B	D1,D4
	MOVE.B	D4,(A2)+
	SUBQ.L	#1,D0
	BNE.S	lbC0007BE
;;;	MOVE.L	(SP)+,D0
;;;	MOVEM.L	(SP)+,D1-D7/A0-A6
	MOVEQ	#1,D0				; Success
	RTS

lbC0007D8	MOVEQ	#0,D4
	MOVEQ	#0,D5
lbC0007DC	MOVE.B	(A2),D1
	LSR.B	#1,D1
	BCC.S	lbC0007E6
	NEG.B	D1
	SUBQ.B	#1,D1
lbC0007E6	ADD.B	D1,D4
	ADD.B	D4,D5
	MOVE.B	D5,(A2)+
	SUBQ.L	#1,D0
	BNE.S	lbC0007DC
;;;	MOVE.L	(SP)+,D0
;;;	MOVEM.L	(SP)+,D1-D7/A0-A6
	MOVEQ	#1,D0				; Success
	RTS

lbC0007F8	MOVEQ	#0,D4
lbC0007FA	MOVE.B	(A2),D1
	LSR.B	#1,D1
	BCC.S	lbC000804
	NEG.B	D1
	SUBQ.B	#1,D1
lbC000804	MOVE.B	D1,(A2)+
	SUBQ.L	#1,D0
	BNE.S	lbC0007FA
;;;	MOVE.L	(SP)+,D0
;;;	MOVEM.L	(SP)+,D1-D7/A0-A6
	MOVEQ	#1,D0				; Success
	RTS

SQ_Error
	MOVEQ	#0,D0				; Error
	RTS

	END
