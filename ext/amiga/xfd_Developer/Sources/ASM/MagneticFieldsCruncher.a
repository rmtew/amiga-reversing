*******************************************************
**             XFD external decruncher               **
**          for Magnetic Fields Cruncher             **
**             adapted by Wanted Team                **
*******************************************************

; Changes by Ronald van Dijk:	original version 2.1 (09.06.2001)
; o Crunched size and decrunched size are checked to be non-zero
; o Number of biplanes is checked to be >= 3 and <= 6
; o SQ Compression Mode is checked to be >= 1 and <= 3
; o Crunched size is tested to be a multiple of 4 when applicable
; o Recalculated the minimum crunched size for each format
; o Split up the DecrunchBuffer functions for SF and SQ
; o The SF decruncher no longer modifies the crunched data buffer
; o Reduced stack and memory usage where possible
; o The RecogBuffer functions now test if enough of the file is loaded
; o Added buffer overflow checks in SF and SQ decrunchers

;;;	INCLUDE	"AINCLUDE:IncDirs.i"
	INCLUDE	"libraries/xfdmaster.i"

; xfdForeman structure MUST be first thing in all external decrunchers

ForeMan		moveq	#-1,d0		;security
		rts
		dc.l	XFDF_ID		;id
		dc.w	1		;version
		dc.w	0
		dc.l	0,0		;private
		dc.l	S_SQ		;first slave

**************************************************

; xfdSlave structure: this one doesn't support data scanning

S_SQ		dc.l	S_SP		;next slave
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SQ		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SQ		;recog buffer
		dc.l	DB_SQ		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	10+4

S_SP		dc.l	S_SF		;next slave
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SP		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SP		;recog buffer
		dc.l	DB_SCSP		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	12+4

S_SF		dc.l	S_SC		;next slave
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SF		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SF		;recog buffer
		dc.l	DB_SF		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	10+1

S_SC		dc.l	S_SA_1		;next slave
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SC		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SC		;recog buffer
		dc.l	DB_SCSP		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	12+(8*2)+4

S_SA_1		dc.l	S_SA_2		;next slave
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SA_1		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SA_1		;recog buffer
		dc.l	DB_SA_1		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	12+4+16

S_SA_2		dc.l	S_SA_3		;next slave
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SA_2		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SA_2		;recog buffer
		dc.l	DB_SA_2		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	22

S_SA_3		dc.l	0		;no more slaves
		dc.w	2		;version
		dc.w	39		;master version
		dc.l	N_SA_3		;name
		dc.w	XFDPFF_DATA!XFDPFF_RECOGLEN!XFDPFF_USERTARGET
		dc.w	0
		dc.l	RB_SA_3		;recog buffer
		dc.l	DB_SA_3		;decrunch buffer
		dc.l	0		;recog segment
		dc.l	0		;decrunch segment
		dc.w	0
		dc.w	XFDID_SACFPQCruncher
		dc.l	22

	dc.b	"$VER: Magnetic Fields Cruncher 2.2 (26.10.2002) by Wanted Team",0
N_SA_1	dc.b	"Magnetic Fields data cruncher (SA - anim mode 1)",0
N_SA_2	dc.b	"Magnetic Fields data cruncher (SA - anim mode 2)",0
N_SA_3	dc.b	"Magnetic Fields data cruncher (SA - anim mode 3)",0
N_SC	dc.b	"Magnetic Fields data cruncher (SC - colours picture mode)",0
N_SF	dc.b	"Magnetic Fields data cruncher (SF - data file mode)",0
N_SP	dc.b	"Magnetic Fields data cruncher (SP - picture mode)",0
N_SQ	dc.b	"Magnetic Fields data cruncher (SQ - sample mode)",0
	even

;-------------------------------------------------

; Recog buffer function: receives buffer + length in a0/d0

RB_SQ	cmp.w	#"SQ",(A0)+
	bne.b	.NoSQ
	tst.b	(A0)
	bne.b	.NoSQ
	move.l	(A0)+,D0			; Decrunched Size
	beq.b	.NoSQ
	move.b	(A0),D1				; Compression Mode
	beq.b	.NoSQ
	cmp.b	#3,D1
	bhi.b	.NoSQ
	move.l	(A0),D1
	and.l	#$00FFFFFF,D1			; Crunched Size
	beq.b	.NoSQ
	move.l	D0,xfdrr_FinalTargetLen(A1)
	addq.l	#7,D0				; Round to the next multiple of 8
	and.b	#$F8,D0
	move.l	D0,xfdrr_MinTargetLen(A1)
	moveq	#10,D0
	asl.l	#2,D1
	add.l	D1,D0
	move.l	D0,xfdrr_MinSourceLen(A1)
	moveq	#1,D0
.exit	rts

.NoSQ	moveq	#0,D0
	bra.b	.exit

; Recog buffer function: receives buffer + length in a0/d0

RB_SP	cmp.w	#"SP",(A0)+
	bne.b	.NoSP
	move.w	(A0)+,D0			; Number of bitplanes
	cmp.w	#3,D0
	blo.b	.NoSP
	cmp.w	#6,D0
	bhi.b	.NoSP
	tst.l	(A0)				; Decrunched Size of 1 bitplane
	beq.b	.NoSP
	move.l	4(A0),D1			; Crunched Size
	beq.b	.NoSP
	and.b	#$03,D1				; should be a multiple of 4
	bne.b	.NoSP
	subq.l	#1,D0
	moveq	#0,D1
.loop	add.l	(A0),D1				; Decrunched Size of 1 bitplane
	dbf	D0,.loop
	move.l	D1,xfdrr_FinalTargetLen(A1)
	add.l	D1,D1
	add.l	#64+16384+8256,D1		; extra buffer length
	move.l	D1,xfdrr_MinTargetLen(A1)
	moveq	#12,D0
	add.l	4(A0),D0			; Crunched Size
	move.l	D0,xfdrr_MinSourceLen(A1)
	moveq	#1,D0
.exit	rts

.NoSP	moveq	#0,D0
	bra.b	.exit

; Recog buffer function: receives buffer + length in a0/d0

RB_SF	cmp.w	#"SF",(A0)+
	bne.b	.NoSF
	tst.b	(A0)
	bne.b	.NoSF
	move.l	(A0)+,D1			; Decrunched Size
	beq.b	.NoSF
	tst.b	(A0)
	bne.b	.NoSF
	tst.l	(A0)				; Crunched Size
	beq.b	.NoSF
	move.l	D1,xfdrr_FinalTargetLen(A1)
;;	moveq	#64,D0				; extra buffer length
;;	add.l	D0,D1
	move.l	D1,xfdrr_MinTargetLen(A1)
	moveq	#10,D0
	add.l	(A0),D0				; Crunched Size
	move.l	D0,xfdrr_MinSourceLen(A1)
	moveq	#1,D0
.exit	rts

.NoSF	moveq	#0,D0
	bra.b	.exit

; Recog buffer function: receives buffer + length in a0/d0

RB_SC	cmp.w	#"SC",(A0)+
	bne.b	.NoSC
	move.w	(A0)+,D0			; Number of bitplanes
	cmp.w	#3,D0
	blo.b	.NoSC
	cmp.w	#6,D0
	bhi.b	.NoSC
	tst.l	(A0)				; Decrunched size of 1 bitplane
	beq.b	.NoSC
	move.l	4(A0),D1			; Crunched size
	beq.b	.NoSC
	and.b	#$03,D1				; should be a multiple of 4
	bne.b	.NoSC
	subq.l	#1,D0
	moveq	#0,D1
.loop	add.l	(A0),D1				; Decrunched size of 1 bitplane
	dbf	D0,.loop
	move.l	D1,xfdrr_FinalTargetLen(A1)
	add.l	D1,D1
	add.l	#64+16384+8256,D1		; extra buffer length
	move.l	D1,xfdrr_MinTargetLen(A1)
	moveq	#12,D0
	add.l	4(A0),D0
	move.l	D0,xfdrr_MinSourceLen(A1)
	moveq	#1,D0
.exit	rts

.NoSC	moveq	#0,D0
	bra.b	.exit

; Recog buffer function: receives buffer + length in a0/d0

RB_SA_2	movem.l	D2-D4,-(SP)
	cmp.w	#"SA",(A0)+
	bne.b	.NoSA_2
	move.w	(A0)+,D0			; Number of Bitplanes
	cmp.w	#3,D0
	blo.b	.NoSA_2
	cmp.w	#6,D0
	bhi.b	.NoSA_2
	moveq	#0,D1
	move.w	(A0)+,D1
	tst.b	(A0)
	bne.b	.NoSA_2
	move.l	(A0)+,D2			; Decrunched Size
	beq.b	.NoSA_2
	move.l	(A0)+,D3
	cmp.l	D3,D2
	ble.b	.NoSA_2
	asl.w	#3,D1
	move.l	4(A0),D4
	add.l	D1,A0
	cmp.l	-4(A0),D4
	bne.b	.NoSA_2
	cmp.l	-12(A0),D4
	bne.b	.NoSA_2
	moveq	#14,D0
	add.l	D1,D0
	add.l	D3,D0
	move.l	D2,xfdrr_FinalTargetLen(A1)
	add.l	#30+16384,D2			; extra buffer length
	move.l	D2,xfdrr_MinTargetLen(A1)
	move.l	D0,xfdrr_MinSourceLen(A1)
	moveq	#1,D0
.exit	movem.l	(SP)+,D2-D4
	rts

.NoSA_2	moveq	#0,D0
	bra.b	.exit

; Recog buffer function: receives buffer + length in a0/d0

RB_SA_3	movem.l	D2-D5/A2,-(SP)
	move.l	A0,A2
	cmp.w	#"SA",(A2)+
	bne.w	.NoSA_3
	move.w	(A2)+,D1			; Number of Bitplanes
	cmp.w	#3,D1
	blo.b	.NoSA_3
	cmp.w	#6,D1
	bhi.b	.NoSA_3
;;	tst.b	(A2)
;;	bne.b	.NoSA_3
;;	addq.l	#2,A2
	moveq	#0,D1
	move.w	(A2)+,D1
	tst.b	(A2)
	bne.b	.NoSA_3
	move.l	(A2)+,D2			; Decrunched Size
	beq.b	.NoSA_3
	move.l	(A2)+,D3
	cmp.l	D3,D2
	ble.b	.NoSA_3
	asl.w	#3,D1
	move.l	4(A2),D4

	add.l	D1,A2
	cmp.l	-4(A2),D4
	bne.b	.ok
	cmp.l	-12(A2),D4
	beq.b	.NoSA_3
.ok	move.l	D2,xfdrr_FinalTargetLen(A1)
	add.l	#32+16384,D2			; extra buffer length
	move.l	D2,xfdrr_MinTargetLen(A1)
	move.l	A0,A2

	ADD.L	A0,D0				; end address of loaded file
	SUBQ.L	#4,D0

	MOVE.W	4(A0),D4
	ADDA.W	#14,A0
	SUBQ.W	#1,D4
.rbC0000CC	ADDQ.W	#4,A0

	CMP.L	D0,A0				; still within loaded file?
	BHI.B	.exitok				; no, skip further checking

	MOVE.L	(A0)+,D2
	SWAP	D2
	LSR.W	#8,D2
	MOVE.W	D2,D5
	LSR.W	#2,D5
	ANDI.W	#3,D2
	BEQ.S	.rbC0000E8
	CMPI.W	#3,D2
	BEQ.S	.rbC0000E8
	ADD.W	D2,D2
	BRA.S	.rbC0000EA

.rbC0000E8	MOVEQ	#0,D2
.rbC0000EA	MOVEQ	#5,D1
.rbC0000EC	LSR.W	#1,D5
	BCC.S	.rbC0000F2
	ADDQ.W	#4,D2
.rbC0000F2	DBRA	D1,.rbC0000EC
	ADDQ.W	#2,D2
	ADDA.W	D2,A0
	DBRA	D4,.rbC0000CC
	sub.l	A2,A0
	add.l	A0,D3
	move.l	D3,xfdrr_MinSourceLen(A1)
.exitok	moveq	#1,D0
.exit	movem.l	(SP)+,D2-D5/A2
	rts

.NoSA_3	moveq	#0,D0
	bra.b	.exit

; Recog buffer function: receives buffer + length in a0/d0

RB_SA_1	movem.l	D2-D4,-(SP)
	cmp.w	#"SA",(A0)+
	bne.b	.NoSA_1
	move.w	(A0)+,D1			; Number of Bitplanes
	cmp.w	#3,D1
	blo.b	.NoSA_1
	cmp.w	#6,D1
	bhi.b	.NoSA_1
	tst.b	(A0)
	bne.b	.NoSA_1
	move.l	(A0)+,D2			; Decrunched Size of 1 bitplane
	beq.b	.NoSA_1
	tst.b	(A0)
	bne.b	.NoSA_1
	move.l	(A0)+,D3			; Crunched Size
	beq.b	.NoSA_1
	move.b	D3,D4
	and.b	#$03,D4				; should be a multiple of 4
	bne.b	.NoSA_1

; Further detection is only possible if the loaded part of the file
; is >= 12+D3+12

	sub.l	D3,D0
	sub.l	#12+12,D0
	bmi.b	.NoSA_1				; Not enough loaded

	add.l	D3,A0
	addq.l	#2,A0
	cmp.w	(A0)+,D1			; Number of Bitplanes
	bne.b	.NoSA_1
	cmp.l	(A0)+,D2			; Decrunched Size of 1 bitplane
	bne.b	.NoSA_1
	tst.w	(A0)
	bne.b	.NoSA_1
	move.l	(A0),D0
	beq.b	.NoSA_1
	and.b	#$07,D0				; should be a multiple of 8
	bne.b	.NoSA_1
	moveq	#20,D0
	add.l	(A0),D0
	add.l	D3,D0
	move.l	D0,xfdrr_MinSourceLen(A1)
	subq.w	#1,D1
	moveq	#8,D0
.loop	add.l	D2,D0				; Decrunched Size of 1 bitplane
	dbf	D1,.loop
	add.l	(A0),D0
	move.l	D0,xfdrr_FinalTargetLen(A1)
	add.l	#56+16384+8256,D0		; extra buffer length
	move.l	D0,xfdrr_MinTargetLen(A1)
	moveq	#1,D0
.exit	movem.l	(SP)+,D2-D4
	rts

.NoSA_1	moveq	#0,D0
	bra.b	.exit

;-------------------------------------------------

; Decrunch buffer function: receives bufferinfo in a0
; This style requires xfdmaster.library V39

DB_SA_1	movem.l	D2-D7/A2-A6,-(SP)
	move.l	A0,A5
	move.l	xfdbi_UserTargetBuf(A5),A1
	move.l	xfdbi_SourceBuffer(A5),A0
	move.l	xfdbi_FinalTargetLen(A5),D3

;;	btst	#0,D3
;;	beq.b	even_1
;;	addq.l	#1,D3
;; even_1

	addq.l	#1,D3
	and.b	#$FE,D3

	lea	0(A1,D3.L),A3

	move.l	xfdbi_MinSourceLen(A5),$828-$7FC(A3)

	lea	56(A3),A2
	lea	16384(A2),A5

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (56 bytes)
; A5 -> Workspace (8256 bytes)
; $2C(A3) = Crunched data size

	bsr.w	D_SASP_1
	moveq	#1,D0
	movem.l	(SP)+,D2-D7/A2-A6
	rts

;-------------------------------------------------

; Decrunch buffer function: receives bufferinfo in a0
; This style requires xfdmaster.library V39

DB_SA_2	movem.l	D2-D7/A2-A6,-(SP)
	move.l	A0,A5
	move.l	xfdbi_UserTargetBuf(A5),A1
	move.l	xfdbi_SourceBuffer(A5),A0
	move.l	xfdbi_FinalTargetLen(A5),D3

;;	btst	#0,D3
;;	beq.b	even_2
;;	addq.l	#1,D3
;;even_2

	addq.l	#1,D3
	and.b	#$FE,D3

	lea	0(A1,D3.L),A3
	lea	30(A3),A2
;;;	move.l	xfdbi_MinSourceLen(A5),12(A3)

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (30 bytes)
;;; ; $C(A3) = Crunched data size

	bsr.w	D_SA_2
	moveq	#1,D0
	movem.l	(SP)+,D2-D7/A2-A6
	rts

;-------------------------------------------------

; Decrunch buffer function: receives bufferinfo in a0
; This style requires xfdmaster.library V39

DB_SA_3	movem.l	D2-D7/A2-A6,-(SP)
	move.l	A0,A5
	move.l	xfdbi_UserTargetBuf(A5),A1
	move.l	xfdbi_SourceBuffer(A5),A0
	move.l	xfdbi_FinalTargetLen(A5),D3

;;	btst	#0,D3
;;	beq.b	even_3
;;	addq.l	#1,D3
;;even_3

	addq.l	#1,D3
	and.b	#$FE,D3

	lea	0(A1,D3.L),A3
	lea	32(A3),A2
;;;	move.l	xfdbi_MinSourceLen(A5),12(A3)

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (32 bytes)
;;; ; $C(A3) = Crunched data size

	bsr.w	D_SA_3
	moveq	#1,D0
	movem.l	(SP)+,D2-D7/A2-A6
	rts

;-------------------------------------------------

; Decrunch buffer function: receives bufferinfo in a0
; This style requires xfdmaster.library V39

DB_SF	MOVEM.L	D2-D7/A2/A4-A6,-(SP)
	MOVE.L	A0,A5
	MOVE.L	xfdbi_UserTargetBuf(A5),A1
	MOVE.L	xfdbi_SourceBuffer(A5),A0

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer (destination)

	BSR	D_SF

	TST.L	D0
	BNE.S	.exit

	MOVE.W	#XFDERR_CORRUPTEDDATA,xfdbi_Error(A5)

.exit	MOVEM.L	(SP)+,D2-D7/A2/A4-A6
	RTS

;-------------------------------------------------

; Decrunch buffer function: receives bufferinfo in a0
; This style requires xfdmaster.library V39

DB_SQ	MOVEM.L	D2-D7/A2-A3/A5,-(SP)
	MOVE.L	A0,A5
	MOVE.L	xfdbi_UserTargetBuf(A5),A1
	MOVE.L	xfdbi_SourceBuffer(A5),A0

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer (destination)

	BSR	D_SQ
	TST.L	D0
	BNE.S	.exit

	MOVE.W	#XFDERR_CORRUPTEDDATA,xfdbi_Error(A5)

.exit	MOVEM.L	(SP)+,D2-D7/A2-A3/A5
	RTS

;-------------------------------------------------

; Decrunch buffer function: receives bufferinfo in a0
; This style requires xfdmaster.library V39

DB_SCSP	movem.l	D2-D7/A2-A6,-(SP)
	move.l	A0,A4
	move.l	xfdbi_UserTargetBuf(A4),A1
	move.l	xfdbi_SourceBuffer(A4),A0
;;;	move.l	xfdbi_MinSourceLen(A4),D0
	move.l	xfdbi_TargetBufSaveLen(A4),D3
	add.l	D3,D3
	lea	0(A1,D3.L),A3
	lea	64(A3),A2
	lea	16384(A2),A5
;;;	move.l	D0,12(A3)
	lsr.l	#1,D3

	movem.l	D0-A6,-(SP)

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer, 1st half (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (24 bytes)
; A5 -> Workspace (8256 bytes)
;;; ; $C(A3) = Crunched data size

	bsr.w	D_SCSP_2
	movem.l	(SP)+,D0-A6

	lea	0(A1,D3.L),A1
;;;	move.l	D0,12(A3)

	movem.l	D0-A6,-(SP)

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer, 2nd half (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (24 bytes)
; A5 -> Workspace (8256 bytes)
;;; ; $C(A3) = Crunched data size

	bsr.w	D_SCSP_2
	movem.l	(SP)+,D0-A6

	movem.l	D0-A6,-(SP)
	move.l	A1,A2
	sub.l	D3,A1
	move.l	A2,A0
CheckData
	cmp.l	A1,A0
	beq.b	FileOK
	move.b	(A2)+,D0
	cmp.b	(A1)+,D0
	bne.b	Old_Mode
	bra.b	CheckData
FileOK
	cmp.l	#640,D3
	bne.b	NoExcept1
	cmp.l	#'KKK@',154(A0)				; exception 1
	beq.b	Old_Mode
	bra.b	Correct
NoExcept1
	cmp.l	#40000,D3
	bne.b	Correct
	cmp.l	#'DDDD',16188(A0)			; exception 2
	beq.b	Old_Mode
Correct
	movem.l	(SP)+,D0-A6
back
	moveq	#1,D0
	movem.l	(SP)+,D2-D7/A2-A6
	rts
Old_Mode
	movem.l	(SP)+,D0-A6
;;;	move.l	D0,$828-$7FC(A3)
	sub.l	D3,A1

; A0 -> Crunched data (source)
; A1 -> Decrunch buffer (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (56 bytes)
; A5 -> Workspace (8256 bytes)
;;; ; $2C(A3) = Crunched data size

	bsr.w	D_SASCSP_1
	bra.b	back

