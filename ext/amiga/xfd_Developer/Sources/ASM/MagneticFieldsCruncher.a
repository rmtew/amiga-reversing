; SC_2, SP_2 Decruncher
; A0 -> Crunched data (source)
; A1 -> Decrunch buffer, 1st half (destination)
; A2 -> Workspace (16k bytes)
; A3 -> Workspace (24 bytes)
; A5 -> Workspace (8256 bytes)
;;; ; $C(A3) = Crunched data size

; A3 data structure:
; $00(A3) 4 BYTEs		[Unused]
; $04(A3) LONG Decrunched Size	[Removed]
; $08(A3) LONG ????
; $0C(A3) LONG Crunched Size	[Unused]
; $10(A3) WORD Number of Bitplanes
; $12(A3) WORD ???? (Value 4 or 3)
; $14(A3) WORD ???? (Value 7, 5 or 4)
; $16(A3) WORD ????
; $18(A3) End of table, in total 24 bytes are required

lbC000050	MOVE.W	$10(A3),D1
	MOVEQ	#0,D7
.lbC000056	ADD.L	D0,D0
	BNE.S	.lbC000062
	MOVE.L	-(A0),D0
	MOVE.W	#$FFFF,CCR
	ADDX.L	D0,D0
.lbC000062	ROXR.B	#1,D7
	DBRA	D1,.lbC000056
	RTS

D_SCSP_2
	movem.l	D1-D7/A0-A6,-(SP)
	cmp.w	#'SC',(A0)
	beq.b	D_SC_2

