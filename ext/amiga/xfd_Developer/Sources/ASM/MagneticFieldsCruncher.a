;;; ; $2C(A3) = Crunched data size

; A3 data structure:
; $00(A3)                 8 BYTEs		[Unused]
; $08(A3)                 LONG ????
; $0C(A3)                 $18 BYTEs		[Unused]
; $820-$7FC(A3) = $24(A3) WORD ????
; $822-$7FC(A3) = $26(A3) WORD ????
; $824-$7FC(A3) = $28(A3) WORD ???? (Value 7, 5 or 4)
; $826-$7FC(A3) = $2A(A3) WORD ???? (Value 4 or 3)
; $828-$7FC(A3) = $2C(A3) LONG Crunched Size	[Unused]
; $82C-$7FC(A3) = $30(A3) 4 BYTEs		[Unused]
; $830-$7FC(A3) = $34(A3) LONG Decrunched Size	[Unused]
; $38(A3) End of table, in total 56 bytes are required

