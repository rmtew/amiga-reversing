; Decruncher from game "Crystal Dragon" (c) 1994 by Magnetic Fields

*****************************************
*					*
* descrunch any file			*
*					*
* from a0 to a1				*
* if pic, 16k buffer needed at a2	*
* if colrs stored palette goes to d1	*
* initial size of file in d0      	*
* 					*
* first word 				*
* 					*
* "SA" sout crunched anim file		*
* "SP" sout crunched pic file		*
* "SC" sout crunched pic file + colrs	*
* "SF" sout crunched data file		*
*					*
* returns length descrunched to in d0.l *
*					*
*****************************************

;	MOVEA.L	#lbL06439C,A2
;	MOVE.L	#lbL06839C,D1

;	MOVEM.L	D1-D7/A0-A6,-(SP)
;	LEA	lbL00070E,A3
;	MOVE.L	D0,12(A3)
;	MOVE.W	(A0),D0
;	CMP.W	#'SQ',D0
;	BEQ.L	D_SQ
;	CMP.W	#'SA',D0
;	BEQ.S	D_SA_3
;	CMP.W	#'SP',D0
;	BEQ.L	D_SP_2
;	CMP.W	#'SC',D0
;	BEQ.L	D_SC_2
;	CMP.W	#'SF',D0
;	BEQ.L	D_SF
;	MOVE.L	12(A3),D7
;	BEQ.S	lbC000046
;lbC000040	MOVE.B	(A0)+,(A1)+
;	SUBQ.L	#1,D7
;	BNE.S	lbC000040
;lbC000046	MOVE.L	12(A3),D0
;	MOVEM.L	(SP)+,D1-D7/A0-A6
;	RTS

; SA_3 decruncher:
; Input: A0 -> Crunched Data (source)
;        A1 -> Decrunch Buffer (destination)
;        A2 -> Workspace (16k bytes)
;        A3 -> Workspace (32 bytes)
;;; ;        $C(A3) = Crunched data size
; Used registers: All

; A3 data structure:
; $00(A3) LONG Decrunch Buffer destination
; $04(A3) LONG Decrunched Size	[Removed]
; $08(A3) LONG ????
; $0C(A3) LONG Crunched Size	[Unused]
; $10(A3) WORD Number of Bitplanes
; $12(A3) WORD ???? (Value 4 or 3)
; $14(A3) WORD ???? (Value 7, 5 or 4)
; $16(A3) ?			[Unused]
; $18(A3) WORD ????
; $1A(A3) WORD ????
; $1C(A3) WORD ????
; $1E(A3) WORD ????
; $20(A3) End of table, in total 32 bytes are required


lbW00006A	DC.W	7,5,4,4
		DC.W	4,4,3,3

D_SA_3	MOVEM.L	D1-D7/A0-A6,-(SP)

	MOVEA.L	A1,A4				; Decrunch Buffer
	MOVE.L	A1,(A3)
	MOVE.W	2(A0),D0			; Number of Bitplanes
	MOVE.W	D0,$10(A3)
	MOVE.W	4(A0),$18(A3)
	MOVE.L	6(A0),D1			; Decrunched Size
;;;;	MOVE.L	D1,4(A3)
	ADD.W	D0,D0
	LEA	lbW00006A(PC),A1
	MOVE.W	-6(A1,D0.W),$14(A3)
	MOVE.W	8-6(A1,D0.W),$12(A3)
	MOVE.L	10(A0),D0			; Crunched Size
	ADDA.W	#14,A0
	MOVE.W	$18(A3),D4
	SUBQ.W	#1,D4
	MOVE.L	D0,-(SP)
lbC0000CC	ADDQ.W	#4,A0
	MOVE.L	(A0)+,D2
	SWAP	D2
	LSR.W	#8,D2
	MOVE.W	D2,D5
	LSR.W	#2,D5
	ANDI.W	#3,D2
	BEQ.S	lbC0000E8
	CMPI.W	#3,D2
	BEQ.S	lbC0000E8
	ADD.W	D2,D2
	BRA.S	lbC0000EA

lbC0000E8	MOVEQ	#0,D2
lbC0000EA	MOVEQ	#5,D0
lbC0000EC	LSR.W	#1,D5
	BCC.S	lbC0000F2
	ADDQ.W	#4,D2
lbC0000F2	DBRA	D0,lbC0000EC
	ADDQ.W	#2,D2
	ADDA.W	D2,A0
	DBRA	D4,lbC0000CC
	MOVE.L	(SP)+,D0
	MOVEA.L	A0,A1
	ADDA.L	D0,A0
	MOVE.W	$10(A3),(A4)
	ADDA.L	D1,A4				; End of Decrunch Buffer
	CLR.W	$1A(A3)
