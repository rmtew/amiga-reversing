  "semantics": {
    "entry": "Inventory-panel bit2, no fire and unchanged selection return before cache update. Changed selection is cached before state/range checks.",
    "state": "0 admits only SDI disk;1 admits six card IDs32..37; negative,2 and other positive states ignore changed selections after caching.",
    "disk": "Consume ID38, refresh holding UI, set context bit6 and advance state0 to1; neither this nor final arming reloads inherited countdown. Bit name identifies producer condition; later reader/use is not established.",
    "card": "All six colors consume one submission; only blue33,scarlet35,ochre36 increment qualifying BYTE. No order/uniqueness check, and qualifying count wraps.",
    "completion": "Store name pointer at base+4*submitted_BYTE before incrementing; only incremented low BYTE==3 triggers validation. Counts outside0..2 are not guarded. WORD255+1 becomes256, and non-final BYTE store becomes0.",
    "name_storage": "Existing12-byte/three-pointer declaration is preserved as the source storage prefix, not widened to cover synthetic out-of-bounds stores.",
